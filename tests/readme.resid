// The README's examples, compiled and run (tests/run.sh regenerates the
// derived region with resid-derive --inplace).
import "../src/serial.resid";
import "../src/value.resid";
import "../src/serial_test.resid";

//@ serial(rename_all = "camelCase")
type User = { Str user_name; Option(Str) email; List(Int) scores; };

//@ serial(deny_unknown_fields)
type Config = {
    Str host;                     //@ rename = "hostname", alias = "server"
    Int port;                     //@ default = "default_port"
    Option(Str) note;             //@ skip_encoding_if = "is_none_str"
    Str secret;                   //@ skip, default
};

//@ serial(tag = "kind", rename_all = "snake_case")
type Event = Started(Config) | Stopped;

pub Int default_port() { return 8080; }
pub Bool is_none_str(Option(Str) s) { return match s { Some(x) => false, None => true }; }

type Point = { Int x; Int y; };

@needs(Encoder(F))
Result(F, SerialError) enc_point(Point p, F s) {
    F s1 = write_struct_begin(s, "Point", 2)?;
    F s2 = write_named(s1, "x", p.x)?;
    F s3 = write_named(s2, "y", p.y)?;
    return write_struct_end(s3);
}
Encode(Point, F) = enc_point;

Int main() {
    User u = User {.user_name = "ann", .email = None, .scores = [3, 5]};
    Value v = to_value(u) else { VUnit };
    println(f"{v}");
    Result(User, SerialError) back = from_value(v);
    println(f"{back}");

    Value cfg = vstruct("", [vfield("server", VStr("db")), vfield("note", VNone)]);
    Result(Config, SerialError) c = from_value(cfg);
    println(f"{c}");
    Event ev = Started(Config {.host = "h", .port = 1, .note = None, .secret = "s"});
    println(f"{to_value(ev)}");

    Bool ok = assert_ser_tokens(Point {.x = 1, .y = 2}, [
        TokStruct(struct_tok("Point", 2)),
        TokField("x"), TokInt(1), TokField("y"), TokInt(2),
        TokStructEnd
    ]);
    println(f"assert_ser_tokens {ok}");
    return 0;
}

