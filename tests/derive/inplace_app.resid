// resid-derive --inplace: types, generated instances and main in one file.
import "../../src/serial.resid";
import "../../src/value.resid";

//@ serial(rename_all = "SCREAMING_SNAKE_CASE")
type Config = { Str host_name; Int port; Option(Level) level; };

//@ serial(rename_all = "kebab-case")
type Level = Debug | InfoOnly | WarnAndUp;

Int main() {
    Config c = Config {.host_name = "db", .port = 5432, .level = Some(WarnAndUp)};
    Value v = to_value(c) else { VUnit };
    println(f"{v}");
    Result(Config, SerialError) back = from_value(v);
    println(f"{back}");
    return 0;
}

