// ── Untagged (line 139)
pub List(Str) derive_untagged_variants() { return ["UInt1", "UStr", "URec", "UNone"]; }
@needs(Encoder(F))
pub Result(F, SerialError) derive_untagged_encode(Untagged v, F s) {
    return match v {
        UInt1(x) => encode(x, s),
        UStr(x) => encode(x, s),
        URec(x) => encode(x, s),
        UNone => write_unit(s),
        UHidden(x) => Err(custom_error("variant UHidden is not encodable"))
    };
}
Encode(Untagged, F) = derive_untagged_encode;
@needs(Decoder(F))
pub Result(Parsed(Untagged, F), SerialError) derive_untagged_decode(F s) {
    Parsed(Value, F) pv = decode(s)?;
    Value v = pv.value;
    Result(Int, SerialError) r0 = from_value(v);
    if (Ok(x0) = r0) { Untagged u0 = UInt1(x0); return parsed(u0, pv.rest); }
    Result(Str, SerialError) r1 = from_value(v);
    if (Ok(x1) = r1) { Untagged u1 = UStr(x1); return parsed(u1, pv.rest); }
    Result(Inner1, SerialError) r2 = from_value(v);
    if (Ok(x2) = r2) { Untagged u2 = URec(x2); return parsed(u2, pv.rest); }
    if (is_unit_value(v)) { Untagged u3 = UNone; return parsed(u3, pv.rest); }
    return Err(custom_error("data did not match any variant of untagged enum Untagged"));
}
Decode(Untagged, F) = derive_untagged_decode;

// ── GenTag(T) (line 143)
pub List(Str) derive_gen_tag_variants() { return ["GOne", "GNone"]; }
@needs(Encoder(F), Encode(T, F), Encode(T, VEnc))
pub Result(F, SerialError) derive_gen_tag_encode(GenTag(T) v, F s) {
    return match v {
        GOne(x) => write_internally_tagged(s, "GenTag", "k", "GOne", to_value(x)?),
        GNone => write_internally_tagged(s, "GenTag", "k", "GNone", VUnit)
    };
}
Encode(GenTag(T), F) = derive_gen_tag_encode;
@needs(Decoder(F), Decode(T, VDec))
pub Result(Parsed(GenTag(T), F), SerialError) derive_gen_tag_decode(F s) {
    Parsed(Value, F) pv = decode(s)?;
    Value v = pv.value;
    TagSplit ts = split_internal_tag(v, "k")?;
    Int i = name_index(derive_gen_tag_variants(), ts.variant);
    if (i == 0) { Result(Holder(T), SerialError) r0 = from_value(ts.rest); Holder(T) x0 = at_variant(r0, "GOne")?; GenTag(T) u0 = GOne(x0); return parsed(u0, pv.rest); }
    if (i == 1) { GenTag(T) u1 = GNone; return parsed(u1, pv.rest); }
    return Err(unknown_variant(ts.variant, derive_gen_tag_variants()));
}
Decode(GenTag(T), F) = derive_gen_tag_decode;
