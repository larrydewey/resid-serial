    Str d_id = get_field_in(v, ["id"])?;
    Inner1 d_pos = from_value(without_fields(v, derive_flat_names()))?;
    Inner2 d_tag = from_value(without_fields(v, derive_flat_names()))?;
    Int d_extra_absent = 0;
    Int d_extra = get_field_in_or(v, ["extra"], d_extra_absent)?;
    return parsed(Flat {.id = d_id, .pos = d_pos, .tag = d_tag, .extra = d_extra}, pv.rest);
}
