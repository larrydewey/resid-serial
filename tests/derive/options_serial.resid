// ── Ext (line 128)
pub List(Str) derive_ext_variants() { return ["Keep", "Drop", "Other", "Else"]; }
@needs(Encoder(F))
pub Result(F, SerialError) derive_ext_encode(Ext v, F s) {
    return match v {
        Keep(x) => write_newtype_variant(s, "Ext", 0, "Keep", x),
        Drop(x) => write_newtype_variant(s, "Ext", 1, "Drop", x),
        Other => write_unit_variant(s, "Ext", 2, "Other")
    };
}
Encode(Ext, F) = derive_ext_encode;
@needs(Decoder(F))
pub Result(Parsed(Ext, F), SerialError) derive_ext_decode(F s) {
    Parsed(Int, F) t = read_variant(s, "Ext", derive_ext_variants())?;
    Int i = t.value;
    if (i == 0) { Parsed(Int, F) p0 = read_newtype_payload(t.rest, "Keep")?; Ext u0 = Keep(p0.value); return parsed(u0, p0.rest); }
    if (i == 1) { Parsed(Str, F) p1 = read_newtype_payload(t.rest, "Drop")?; Ext u1 = Drop(p1.value); return parsed(u1, p1.rest); }
    if (i >= 2 && i < 4) { Ext u2 = Other; return read_unit_payload(t.rest, u2); }
    return Err(custom_error(f"variant index {i} out of range"));
}
Decode(Ext, F) = derive_ext_decode;

