@needs(Decoder(F))
pub Result(Parsed(Skippy, F), SerialError) derive_skippy_decode(F s) {
    Parsed(Int, F) t = read_variant(s, "Skippy", derive_skippy_variants())?;
    Int i = t.value;
    if (i == 0) { Parsed(Int, F) p0 = read_newtype_payload(t.rest, "Shown")?; Skippy u0 = Shown(p0.value); return parsed(u0, p0.rest); }
    if (i == 1) { Skippy u2 = Last; return read_unit_payload(t.rest, u2); }
    return Err(custom_error(f"variant index {i} out of range"));
}
Decode(Skippy, F) = derive_skippy_decode;

// ── Internal (line 135)
pub List(Str) derive_internal_variants() { return ["unit_case", "struct_case", "map_case", "scalar"]; }
@needs(Encoder(F))
pub Result(F, SerialError) derive_internal_encode(Internal v, F s) {
    return match v {
        UnitCase => write_internally_tagged(s, "Internal", "kind", "unit_case", VUnit),
        StructCase(x) => write_internally_tagged(s, "Internal", "kind", "struct_case", to_value(x)?),
        MapCase(x) => write_internally_tagged(s, "Internal", "kind", "map_case", to_value(x)?),
        Scalar(x) => write_internally_tagged(s, "Internal", "kind", "scalar", to_value(x)?)
    };
}
Encode(Internal, F) = derive_internal_encode;
@needs(Decoder(F))
pub Result(Parsed(Internal, F), SerialError) derive_internal_decode(F s) {
    Parsed(Value, F) pv = decode(s)?;
    Value v = pv.value;
    TagSplit ts = split_internal_tag(v, "kind")?;
    Int i = name_index(derive_internal_variants(), ts.variant);
    if (i == 0) { Internal u0 = UnitCase; return parsed(u0, pv.rest); }
    if (i == 1) { Result(Inner1, SerialError) r1 = from_value(ts.rest); Inner1 x1 = at_variant(r1, "struct_case")?; Internal u1 = StructCase(x1); return parsed(u1, pv.rest); }
    if (i == 2) { Result(Map(Str, Int), SerialError) r2 = from_value(ts.rest); Map(Str, Int) x2 = at_variant(r2, "map_case")?; Internal u2 = MapCase(x2); return parsed(u2, pv.rest); }
    if (i == 3) { Result(Int, SerialError) r3 = from_value(ts.rest); Int x3 = at_variant(r3, "scalar")?; Internal u3 = Scalar(x3); return parsed(u3, pv.rest); }
    return Err(unknown_variant(ts.variant, derive_internal_variants()));
}
Decode(Internal, F) = derive_internal_decode;

