    List(VField) fs1 = fs0.concat([vfield("id", to_value(v.id)?)]);
    List(VField) fs2 = fs1.concat(flatten_fields(to_value(v.pos)?)?);
    List(VField) fs3 = fs2.concat(flatten_fields(to_value(v.tag)?)?);
    List(VField) fs4 = if (is_zero(v.extra)) { fs3 } else { fs3.concat([vfield("extra", to_value(v.extra)?)]) };
    Value whole = vstruct("Flat", fs4);
    return encode(whole, s);
}
Encode(Flat, F) = derive_flat_encode;
@needs(Decoder(F))
pub Result(Parsed(Flat, F), SerialError) derive_flat_decode(F s) {
